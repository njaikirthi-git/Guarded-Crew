# Groq API key used by the language model.
GROQ_API_KEY=

# PostgreSQL connection URL used for LangGraph checkpoints.
DATABASE_URL=

# API keys for the search, flight, and weather integrations.
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
# AVIATION_STACK_API_KEY and AVIATIONSTACK_API_KEY are aliases; use either one.
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# Optional LangSmith tracing configuration.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
